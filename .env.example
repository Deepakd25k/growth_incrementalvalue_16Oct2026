# ---------- Required ----------
# Postgres connection string (Vercel → Storage → Neon). Tables are created automatically.
DATABASE_URL=

# Public URL of the site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Admin login for /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string, 32+ characters (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Pixel + Conversions API (Events Manager → your dataset → Settings)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: only while testing in Events Manager → Test events. Remove before going live.
META_TEST_EVENT_CODE=
# Optional: Graph API version, defaults to v24.0
META_API_VERSION=

# ---------- Shown on the site ----------
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits with country code, no + (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Cal.com or Calendly link shown after payment
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LEGAL_NAME=Deepak Gupta
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ---------- Optional: Google ----------
NEXT_PUBLIC_GA4_ID=
# Google Ads purchase conversion, format AW-XXXXXXXXX/LabelXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
